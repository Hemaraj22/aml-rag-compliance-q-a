# --- OpenAI ---
OPENAI_API_KEY=sk-...
LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# --- Retrieval ---
CHROMA_DIR=./chroma_db
COLLECTION_NAME=ffiec_bsa_aml
DATA_DIR=./data/raw
TOP_K=5
MIN_RELEVANCE=0.3

# --- LangSmith (tracing, latency, cost) ---
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=lsv2_...
LANGSMITH_PROJECT=aml-rag

# --- API ---
# If set, POST /ingest requires header "X-API-Key: <value>"
ADMIN_API_KEY=

# --- ChromaDB ---
ANONYMIZED_TELEMETRY=False
